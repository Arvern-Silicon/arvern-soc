//----------------------------------------------------------------------------
// Physical constraints: Sipeed Tang Console 138K (Tang Mega 138K SoM,
// GW5AST-LV138PG484A). Balls from the Console schematic (revisions A, B and C
// agree); every bank used here is at 3.3 V on the 138K SoM.
//----------------------------------------------------------------------------


// 50 MHz oscillator
IO_LOC  "SYS_CLK" V22;
IO_PORT "SYS_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// User buttons EX_KEY.0 / EX_KEY.1 (active low, internal pull-up required)
IO_LOC  "KEY[0]" AA13;
IO_PORT "KEY[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "KEY[1]" AB13;
IO_PORT "KEY[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;


// SoM LEDs: LED[0] on the DONE pin, LED[1] on READY (freed by use_done_as_gpio /
// use_ready_as_gpio in synthesis.tcl); a high output lights them
IO_LOC  "LED[0]" G11;
IO_PORT "LED[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LED[1]" U12;
IO_PORT "LED[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// PMOD0: PMOD0[n] on PMOD0_IOn, GPIO pin n (pulled up while not driven)
IO_LOC  "PMOD0[0]" V18;
IO_PORT "PMOD0[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD0[1]" V19;
IO_PORT "PMOD0[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD0[2]" G21;
IO_PORT "PMOD0[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD0[3]" G22;
IO_PORT "PMOD0[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD0[4]" F18;
IO_PORT "PMOD0[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD0[5]" E18;
IO_PORT "PMOD0[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD0[6]" C22;
IO_PORT "PMOD0[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD0[7]" B22;
IO_PORT "PMOD0[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// PMOD1: PMOD1[n] on PMOD1_IOn, GPIO pin 8 + n (pulled up while not driven,
// except IO7: the Pmod I2S2 ADC's SDOUT, whose 10K pull-down strap selects
// the converter's slave mode at power-up)
IO_LOC  "PMOD1[0]" W19;
IO_PORT "PMOD1[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD1[1]" W20;
IO_PORT "PMOD1[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD1[2]" F19;
IO_PORT "PMOD1[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD1[3]" F20;
IO_PORT "PMOD1[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD1[4]" E22;
IO_PORT "PMOD1[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD1[5]" D22;
IO_PORT "PMOD1[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD1[6]" E21;
IO_PORT "PMOD1[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PMOD1[7]" D21;
IO_PORT "PMOD1[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// SDRAM1 header (J10): SDRAM1[n] = header pin n (1-10); 3.3V / GND references
// on pins 1 / 2, the debug transport on 3-10, inputs pulled up so an unplugged
// probe reads idle
IO_LOC  "SDRAM1[1]" R19;   // 3.3V reference (SSPI_WPN pin), driven high
IO_PORT "SDRAM1[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[2]" P19;   // ground reference (SSPI_CLK pin), driven low
IO_PORT "SDRAM1[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[3]" U21;   // JTAG_TMS / CJTAG_TMSC (SSPI_SI pin)
IO_PORT "SDRAM1[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[4]" T21;   // JTAG_TCK / CJTAG_TCKC
IO_PORT "SDRAM1[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[5]" R17;   // JTAG_TDI
IO_PORT "SDRAM1[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[6]" P16;   // JTAG_TDO
IO_PORT "SDRAM1[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[7]" T18;   // I2C_SDA
IO_PORT "SDRAM1[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[8]" R18;   // I2C_SCL
IO_PORT "SDRAM1[8]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[9]" W17;   // UART_TX
IO_PORT "SDRAM1[9]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SDRAM1[10]" V17;   // UART_RX
IO_PORT "SDRAM1[10]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// USB-A J15 (USB_A1): low-speed USB host D+/D-; the board's 15K pull-downs
// and the device's 1.5K pull-up set the idle levels (no pad pull)
IO_LOC  "USB1_DP" M15;
IO_PORT "USB1_DP" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "USB1_DM" M16;
IO_PORT "USB1_DM" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// USB-A J16 (USB_A2, FPGA_USB2_P / FPGA_USB2_N): the second USB host, same
// pull-downs and pad settings as J15
IO_LOC  "USB2_DP" H13;
IO_PORT "USB2_DP" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "USB2_DM" G13;
IO_PORT "USB2_DM" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 40-pin RGB LCD connector (LCD_DPI.*): RGB888, DE, syncs, pixel clock
IO_LOC  "LCD_CLK" L19;
IO_PORT "LCD_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_DE" U22;
IO_PORT "LCD_DE" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_HSYNC" N20;
IO_PORT "LCD_HSYNC" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_VSYNC" L15;
IO_PORT "LCD_VSYNC" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[0]" J21;
IO_PORT "LCD_R[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[1]" J20;
IO_PORT "LCD_R[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[2]" G18;
IO_PORT "LCD_R[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[3]" G17;
IO_PORT "LCD_R[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[4]" H22;
IO_PORT "LCD_R[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[5]" J22;
IO_PORT "LCD_R[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[6]" K22;
IO_PORT "LCD_R[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_R[7]" K21;
IO_PORT "LCD_R[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[0]" L20;
IO_PORT "LCD_G[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[1]" L14;
IO_PORT "LCD_G[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[2]" K18;
IO_PORT "LCD_G[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[3]" L21;
IO_PORT "LCD_G[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[4]" M21;
IO_PORT "LCD_G[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[5]" M22;
IO_PORT "LCD_G[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[6]" N22;
IO_PORT "LCD_G[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_G[7]" K19;
IO_PORT "LCD_G[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[0]" U8;
IO_PORT "LCD_B[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[1]" L18;
IO_PORT "LCD_B[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[2]" M18;
IO_PORT "LCD_B[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[3]" N19;
IO_PORT "LCD_B[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[4]" N18;
IO_PORT "LCD_B[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[5]" K16;
IO_PORT "LCD_B[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[6]" L16;
IO_PORT "LCD_B[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "LCD_B[7]" M20;
IO_PORT "LCD_B[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Backlight driver enable (LCD_DPI_BL, also pulled up on the board)
IO_LOC  "LCD_BL" P20;
IO_PORT "LCD_BL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// HDMI connector J13 (Console schematic sheet TMDS_TX), bank 3: TMDS lanes as
// emulated LVDS pairs (ELVDS_OBUF, LVCMOS33D: P,N), AC-coupled on the board;
// the hot-plug detect through 51K (no FPGA pull: it would divide the level);
// HDMI_PWR_SAV (K14, 100K pull-down on the board) high switches on the 499R
// resistors the TMDS lines need.
IO_LOC  "HDMI_D_P[0]" J14,H14;
IO_PORT "HDMI_D_P[0]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HDMI_D_P[1]" J15,H15;
IO_PORT "HDMI_D_P[1]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HDMI_D_P[2]" K17,J17;
IO_PORT "HDMI_D_P[2]" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HDMI_CLK_P" G15,G16;
IO_PORT "HDMI_CLK_P" IO_TYPE=LVCMOS33D PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HDMI_HPD" K13;
IO_PORT "HDMI_HPD" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "HDMI_PWR_SAV" K14;
IO_PORT "HDMI_PWR_SAV" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
// DDC: open-drain, 1.8K pull-ups to 3.3 V and a 5 V level shifter on the board
IO_LOC  "HDMI_DDC_SCL" M13;
IO_PORT "HDMI_DDC_SCL" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "HDMI_DDC_SDA" L13;
IO_PORT "HDMI_DDC_SDA" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Onboard MAX98357A amplifier (Console schematic sheet AUDIO): I2S in, no
// MCLK; PA_EN drives SD_MODE through 0R with a 51K pull-down (undriven or low:
// shutdown, high: on, left channel)
IO_LOC  "I2S_BCLK" Y17;
IO_PORT "I2S_BCLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "I2S_LRCK" AB17;
IO_PORT "I2S_LRCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "I2S_DOUT" AA16;
IO_PORT "I2S_DOUT" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "PA_EN" Y14;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// microSD slot J22 in SPI mode (Console schematic sheet SDCARD): 10K pull-ups
// on CMD and DAT0-3 and a 22R series resistor on CLK on the board, behind the
// BL616 analog switch; DAT1 (AB15) and DAT2 (W14) unused. The card detect
// switch needs the FPGA pull-up
IO_LOC  "SD_CLK" V15;
IO_PORT "SD_CLK" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SD_CMD" Y16;
IO_PORT "SD_CMD" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SD_DAT0" AA15;
IO_PORT "SD_DAT0" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "SD_DAT3" W15;
IO_PORT "SD_DAT3" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "SD_DET" Y13;
IO_PORT "SD_DET" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// UART to the onboard BL616 (USB)
IO_LOC  "UART_RXD" V14;
IO_PORT "UART_RXD" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "UART_TXD" U15;
IO_PORT "UART_TXD" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
