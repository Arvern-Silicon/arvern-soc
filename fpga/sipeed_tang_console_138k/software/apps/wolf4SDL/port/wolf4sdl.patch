+
+static void SpriteColumn (int x, int toppix, int scale, const byte *col, byte key)
+{
+    int top = toppix, bot = toppix + 2 * scale, y;
+
+    if (top < 0)
+        top = 0;
+    if (bot > viewheight)
+        bot = viewheight;
+    if (bot <= top)
+        return;
+    if (scale >= 3)
+    {
+        arv_gpu_sprite_post (vbuf + ylookup[top] + x, bot - top, col, scale, top - toppix, key);
