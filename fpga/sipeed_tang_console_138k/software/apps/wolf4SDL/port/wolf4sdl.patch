+
+static void DrawSprite (int xcenter, int shapenum, int16_t scale, int height)
+{
+    int     i, left, right;
+    byte    *tex, key;
+    int16_t toppix, x1, x2, actx;
+    fixed   frac, fracstep;
+
+    tex = PM_GetSpritePage (shapenum);
+    key = PMSpriteKey;
+    left = PMSpriteLeft;
+    right = PMSpriteRight;
+    if (scale < 3)
+        arv_gpu_wait ();                // the CPU draws this one: after the GPU's queue
