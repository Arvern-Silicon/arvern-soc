+#ifdef ARV_DUMP_VARS
+// Tang port: every variable the scripts define, printed for tools/gen_vars.py,
+// which turns them into C (the Tang build links them instead of parsing)
+static void CK_VAR_DumpHex(const char *s)
+{
+	if (!*s)
+		printf(".");
+	for (; *s; ++s)
+		printf("%02x", (unsigned char)*s);
+	printf(" ");
+}
+
+static const char *CK_VAR_FnName(void *fn)
+{
+	if (!fn)
+		return "NULL";
+	for (size_t i = 0; i < ck_functionTable->size; ++i)
+		if (ck_functionTable->arr[i].str && ck_functionTable->arr[i].ptr == fn)
+			return ck_functionTable->arr[i].str;
+	return "?";
+}
+
+void CK_VAR_Dump(void)
+{
+	for (size_t i = 0; i < ck_varTable->size; ++i)
+	{
+		const char *name = ck_varTable->arr[i].str;
+		CK_VAR_Variable *var = (CK_VAR_Variable *)ck_varTable->arr[i].ptr;
+		if (!name)
+			continue;
+		switch (var->type)
+		{
+		case VAR_Bool:
+		case VAR_Int:
+			printf("V INT %s %d\n", name, (int)(intptr_t)var->value);
+			break;
+		case VAR_String:
+			printf("V STR %s ", name);
+			CK_VAR_DumpHex((const char *)var->value);
+			printf("\n");
+			break;
+		case VAR_IntArray:
+			printf("V IARR %s %d", name, (int)var->length);
+			for (size_t k = 0; k < var->length; ++k)
+				printf(" %d", (int)((intptr_t *)var->value)[k]);
+			printf("\n");
+			break;
+		case VAR_StringArray:
+			printf("V SARR %s %d ", name, (int)var->length);
+			for (size_t k = 0; k < var->length; ++k)
+			{
+				CK_VAR_DumpHex(((const char **)var->value)[k]);
+			}
+			printf("\n");
+			break;
+		case VAR_Function:
+			printf("V FUNC %s %s\n", name, CK_VAR_FnName(var->value));
+			break;
+		case VAR_Action:
+			printf("V ACT %s %d\n", name, (int)((CK_action *)var->value - ck_actionData));
+			break;
+		default:
+			printf("V ? %s %d\n", name, (int)var->type);
+		}
+	}
+	for (int i = 0; i < ck_actionsUsed; ++i)
+	{
+		CK_action *a = &ck_actionData[i];
+		printf("A %d %d %d %d %d %d %d %d %d %d %s %s %s %d\n", i, a->compatDosPointer, a->chunkLeft, a->chunkRight,
+			(int)a->type, a->protectAnimation, a->stickToGround, a->timer, a->velX, a->velY,
+			CK_VAR_FnName((void *)a->think), CK_VAR_FnName((void *)a->collide), CK_VAR_FnName((void *)a->draw),
+			a->next ? (int)(a->next - ck_actionData) : -1);
+	}
+	printf("END\n");
+}
+#endif
+#endif // ARV_LINKED_VARS
