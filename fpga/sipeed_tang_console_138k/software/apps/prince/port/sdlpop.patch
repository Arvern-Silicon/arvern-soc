+void close_dat(dat_type* pointer) {
+	dat_type** prev = &dat_chain_ptr;
+	dat_type* curr = dat_chain_ptr;
+	while (curr != NULL) {
+		if (curr == pointer) {
+			*prev = curr->next_dat;
+			pak_close((struct datfile_s *) curr->df);
+			release_dat(curr);
+			return;
+		}
+		curr = curr->next_dat;
+		prev = &((*prev)->next_dat);
+	}
