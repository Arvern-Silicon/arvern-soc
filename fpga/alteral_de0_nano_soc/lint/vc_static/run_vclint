# File Name          : run_vclint
# Module Description : Run Synopsys VC Static lint on the DE0-Nano-SoC FPGA RTL.
#----------------------------------------------------------------------------
# The Verilator lint (sim/rtl_sim/run/run_lint) is unrelated and unaffected;
# this is the signoff-grade flow. Same shape as
# arvern-soc/asic/chip_example/lint/vc_static/run_vclint, minus the fabric axis
# -- this board's ahb_bus_system.v has no build-time variants -- and plus the
# Altera behavioural primitives.
#
# arvern_fpga.v fixes its own parameters, so there is no elaborate override.
# What IS read out of it is the RTL_PARAM_* set that rules.tcl and waivers.tcl
# branch on; see the harvest block below. This board builds ASYNC_RST_EN=0,
# which selects the opposite reset rule from the ASIC -- a run that prints
# "reset style ASYNC" here is wrong.
#
# Run from inside the Synopsys container, or use ./run_vclint_d from the host.

TOP="arvern_fpga"
JOBS=8
DO_LANG=0
RAW=0
NO_QUIT=0

usage() {
    echo "Usage: $0 [options]"
    echo "  -top <name>      Top-level design to elaborate (default: arvern_fpga)"
    echo "  -j <count>       Parallel processes for the language checker (default: 8)"
    echo "  -lang            Also run the LANGUAGE_CHECK stage. Much slower and much"
    echo "                   noisier -- off by default; see rules.tcl"
    echo "  -raw             Ignore rules.tcl and report EVERY enabled rule (firehose;"
    echo "                   use this to re-derive the noise numbers behind the policy)"
    echo "  -noquit, -i      Leave vc_static_shell open after the run"
    echo "  -h, --help       This message"
    exit "${1:-1}"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -top|--top)                TOP="$2"; shift 2 ;;
        -j|--j)                    JOBS="$2"; shift 2 ;;
        -lang|--lang)              DO_LANG=1; shift ;;
        -raw|--raw)                RAW=1; shift ;;
        -noquit|--noquit|-i|--interactive) NO_QUIT=1; shift ;;
        -h|--help)                 usage 0 ;;
        *) echo "Unknown option: $1" >&2; usage 1 ;;
    esac
done

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PRJ_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
AVDEV_ROOT="$(cd "$PRJ_ROOT/../../.." && pwd)"
RESULTS="$SCRIPT_DIR/results"
FLATTEN="$AVDEV_ROOT/arvern/sim/rtl_sim/bin/flatten_filelist.py"
FILELIST_SRC="$PRJ_ROOT/rtl/verilog/filelist.f"
TOP_RTL="$PRJ_ROOT/rtl/verilog/arvern_fpga.v"
# Altera primitives. Quartus supplies altsyncram and cyclonev_io_ibuf/obuf
# natively, so the design filelist deliberately carries neither; the
# behavioural models from bench/ stand in here for the same reason the
# Verilator lint uses them -- so the memory and pad ports stay connected and
# CONN_* checking over them remains meaningful. Noise from inside the models is
# waived by module scope in waivers.tcl rather than black-boxed.
VENDOR_MODELS=(
    "$PRJ_ROOT/bench/verilog/altsyncram.v"
    "$PRJ_ROOT/bench/verilog/cyclonev_io.v"
)

if ! command -v vc_static_shell >/dev/null 2>&1; then
    echo "Error: vc_static_shell not on PATH -- are you inside the Synopsys container?" >&2
    echo "       Run ./run_vclint_d from the host instead." >&2
    exit 1
fi
[[ -f "$FLATTEN" ]]      || { echo "Error: missing $FLATTEN" >&2; exit 1; }
[[ -f "$FILELIST_SRC" ]] || { echo "Error: missing $FILELIST_SRC" >&2; exit 1; }
[[ -f "$TOP_RTL" ]]      || { echo "Error: missing $TOP_RTL" >&2; exit 1; }
for m in "${VENDOR_MODELS[@]}"; do
    [[ -f "$m" ]] || { echo "Error: missing vendor model $m" >&2; exit 1; }
done

mkdir -p "$RESULTS"
rm -rf "${RESULTS:?}"/*

# Single source of truth for the RTL file set, shared with sim and Quartus.
# Flattened in-container so the emitted paths are container-absolute.
echo "Flattening $FILELIST_SRC ..."
python3 "$FLATTEN" --format raw "$FILELIST_SRC" "$RESULTS/arvern_fpga_flat.f" || exit 1

# The vendor models are prepended into a wrapper filelist rather than passed as
# `analyze` options: vc_lint.tcl hands vcst one quoted " -f <list> " string, and
# adding options to it is a quoting fight for no gain.
LINT_F="$RESULTS/arvern_fpga_lint.f"
{
    printf '%s\n' "${VENDOR_MODELS[@]}"
    cat "$RESULTS/arvern_fpga_flat.f"
} > "$LINT_F"

# Harvest the top-level parameter values that rules.tcl and waivers.tcl branch
# on. arvern_fpga.v is the single source of truth for the configuration, so
# reading it here is what keeps the rule policy in step with the design: get
# ASYNC_RST_EN wrong and the run enforces the opposite reset rule on every flop
# on the board. Only plain integer and sized-literal values are emitted;
# anything else (expressions like 32*1024) is skipped as irrelevant here.
PARAMS_TCL="$RESULTS/rtl_params.tcl"
python3 - "$TOP_RTL" "$PARAMS_TCL" <<'PYEOF' || exit 1
import re, sys

src, dst = sys.argv[1], sys.argv[2]
pat = re.compile(r"^\s*parameter\s+(?:signed\s+)?(\w+)\s*=\s*([^;]+);")
lit = re.compile(r"^(?:\d+\s*'\s*[bBoOdDhH])?\s*([0-9a-fA-F_]+)$")
bases = {'b': 2, 'o': 8, 'd': 10, 'h': 16}

out = []
for line in open(src):
    m = pat.match(line)
    if not m:
        continue
    name, val = m.group(1), m.group(2).split('//')[0].strip()
    lm = lit.match(val)
    if not lm:
        continue                       # expression / string / non-numeric: not needed
    digits = lm.group(1).replace('_', '')
    b = 10
    if "'" in val:
        b = bases[val.split("'")[1].strip()[0].lower()]
    try:
        out.append((name, int(digits, b)))
    except ValueError:
        continue

with open(dst, 'w') as fh:
    fh.write("# Auto-generated by run_vclint from %s -- do not edit.\n" % src)
    fh.write("# Read by rules.tcl / waivers.tcl to match the policy to the build.\n")
    for name, v in out:
        fh.write("set RTL_PARAM_%s %d\n" % (name, v))
print("harvested %d parameters from %s" % (len(out), src.split('/')[-1]))
PYEOF

export VCLINT_TOP="$TOP"
export VCLINT_FILELIST="$LINT_F"
export VCLINT_STAGES="Structural_Check Netlist Quick_Lint"
export VCLINT_JOBS="$JOBS"
export VCLINT_DO_LANG="$DO_LANG"
export VCLINT_PARAMS_FILE="$PARAMS_TCL"
export VCLINT_RULES=""
export VCLINT_WAIVERS=""
[[ $RAW -eq 0 && -f "$SCRIPT_DIR/rules.tcl" ]] && VCLINT_RULES="$SCRIPT_DIR/rules.tcl"
[[            -f "$SCRIPT_DIR/waivers.tcl" ]] && VCLINT_WAIVERS="$SCRIPT_DIR/waivers.tcl"

[[ $DO_LANG -eq 1 ]] && export VCLINT_STAGES="Language_Check Structural_Check Netlist Quick_Lint"

echo "================================================================"
echo " arvern_fpga VC STATIC LINT"
echo "   top          : $TOP"
echo "   stages       : $VCLINT_STAGES"
echo "   vendor models: $(basename "${VENDOR_MODELS[0]}") $(basename "${VENDOR_MODELS[1]}")"
echo "   rule policy  : ${VCLINT_RULES:-<none -- RAW MODE>}"
echo "   waivers      : ${VCLINT_WAIVERS:-<none>}"
echo "================================================================"

START_TIME=$SECONDS

# vcst scatters WORK/, vcst_rtdb/, clog*, novas.* into its cwd -- run it from
# results/ so all of it lands in the gitignored output dir.
SHELL_ARGS=(-mode64 -f "$SCRIPT_DIR/vc_lint.tcl")
[[ $NO_QUIT -eq 1 ]] && SHELL_ARGS+=(-i)

( cd "$RESULTS" && vc_static_shell "${SHELL_ARGS[@]}" ) 2>&1 | tee "$RESULTS/vclint.log"
rc=${PIPESTATUS[0]}

ELAPSED=$(( SECONDS - START_TIME ))

print_lint_summary() {
    local summary="$RESULTS/report.lint_summary.txt"
    local fatals=0 errors=0 warnings=0 infos=0 compressed=0 waived=0

    if [[ -f "$summary" ]]; then
        # Management Summary columns are NOT fixed: a "Waived" column appears
        # only once at least one waiver matched, which shifts "Compressed".
        # Map values via the header row rather than by position. Take the first
        # "Total" after the header -- the Tree Summary has its own. Field
        # comparisons only: the container's awk is mawk, which does not support
        # POSIX [[:space:]] bracket expressions.
        local -a v
        v=( $(awk '/Management Summary/ {inms=1}
                   inms && /Fatals/ {
                       nc=0; for (i=1;i<=NF;i++) if ($i!="Stage" && $i!="Family") cols[++nc]=$i
                   }
                   inms && nc && $1=="Total" && $2 ~ /^[0-9]+$/ {
                       for (i=2;i<=NF;i++) val[cols[i-1]]=$i
                       printf "%d %d %d %d %d %d\n", val["Fatals"], val["Errors"], \
                              val["Warnings"], val["Infos"], val["Waived"], val["Compressed"]
                       exit
                   }' "$summary") )
        fatals=${v[0]:-0}; errors=${v[1]:-0}; warnings=${v[2]:-0}
        infos=${v[3]:-0}; waived=${v[4]:-0}; compressed=${v[5]:-0}
    fi
    # Waivers that matched nothing this run -- stale, or conditional waivers
    # registered in a configuration where they do not apply.
    local stale=0
    if [[ -f "$RESULTS/vclint.log" ]]; then
        stale=$(awk '/waivers that matched nothing/ {f=1; next}
                     f && $1=="Waiver" && $2==":" {c++}
                     END {print c+0}' "$RESULTS/vclint.log")
        stale=${stale:-0}
    fi

    local h=$((ELAPSED/3600)) m=$(((ELAPSED%3600)/60)) s=$((ELAPSED%60))
    # "compressed" = near-identical violations folded into a reported one by
    # compress_hdl. Raw total = reported + compressed.
    printf "VC Lint %s: fatal=%s err=%s warn=%s info=%s stale=%s waived=%s  (%dh %dm %ds)\n" \
        "$TOP" "$fatals" "$errors" "$warnings" "$infos" "$stale" "$waived" "$h" "$m" "$s"
    printf "            reported=%s  compressed=%s  raw total=%s\n" \
        "$((fatals + errors + warnings + infos))" "$compressed" \
        "$((fatals + errors + warnings + infos + compressed))"

    # Tree Summary is already a per-tag histogram -- read it rather than
    # re-counting report.lint_full.txt, whose per-tag output is limit-truncated.
    if [[ -f "$summary" ]]; then
        echo ""
        echo "Top tags (severity / tag / count):"
        awk '/Tree Summary/ {ints=1}
             ints && ($1=="error"||$1=="warning"||$1=="fatal"||$1=="info") {
                 printf "  %-8s %-38s %6s\n", $1, $3, $4
             }' "$summary" | sort -k3 -rn | head -20
    fi
}

echo ""
echo "================================================================"
echo " Summary"
echo "================================================================"
if [[ ! -f "$RESULTS/report.lint_summary.txt" ]]; then
    echo "ERROR: no report produced -- see $RESULTS/vclint.log"
    exit "${rc:-1}"
fi
print_lint_summary
echo ""
echo " Reports in: lint/vc_static/results/"
echo "   report.lint_summary.txt    management + tree summary"
echo "   report.lint_full.txt       every violation, sorted, with file:line"
echo "   report.lint_by_family.txt  per-family breakdown"
echo "   report.lint_waived.txt     waived violations only"
echo "================================================================"

exit "$rc"
